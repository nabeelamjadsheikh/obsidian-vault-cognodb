# Connection details for your CognoDB instance.
#
# Create a free c0 instance at https://console.cognodb.com/signup — no credit
# card required. The console gives you a URI of the form below and generates a
# password for the user "cognodb". The password is shown EXACTLY ONCE, so copy
# it immediately.
#
# Copy this file to .env.local and fill in the values. .env.local is gitignored
# and must never be committed.

COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your-generated-password>

# Local development alternative — run `npm run db:up` to start Neo4j in Docker
# (same Bolt protocol, same driver) and use these instead:
#
# COGNODB_URI=bolt://localhost:7687
# COGNODB_USER=neo4j
# COGNODB_PASSWORD=vaultpassword123
